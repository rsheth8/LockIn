<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Copy this file to Secrets.plist (same folder) and fill in your keys.
	     Secrets.plist is gitignored and will never be committed.
	     Any key left as its placeholder just disables that feature — the app
	     still builds and runs. -->

	<!-- https://spoonacular.com/food-api/console#Dashboard -->
	<key>SpoonacularAPIKey</key>
	<string>PASTE_YOUR_KEY_HERE</string>

	<!-- Google Cloud console → APIs & Services → Credentials → iOS OAuth client.
	     Also paste the REVERSED_CLIENT_ID into GOOGLE_REVERSED_CLIENT_ID in
	     project.yml (or a gitignored Local.xcconfig) so the redirect works. -->
	<key>GoogleClientID</key>
	<string>PASTE_YOUR_GOOGLE_CLIENT_ID_HERE</string>

	<!-- https://console.anthropic.com/ — use a Haiku key. Rate-limited on device. -->
	<key>ClaudeAPIKey</key>
	<string>PASTE_YOUR_CLAUDE_KEY_HERE</string>

	<!-- Optional. Default is claude-haiku-4-5-20251001 -->
	<key>ClaudeModel</key>
	<string>claude-haiku-4-5-20251001</string>
</dict>
</plist>
